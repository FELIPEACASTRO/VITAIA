# VITAIA Medical AI - Production Environment Configuration
# Copy this file to .env and configure your production values

# =======================
# APPLICATION SETTINGS
# =======================
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# =======================
# SECURITY CONFIGURATION
# =======================
# CRITICAL: Change this in production!
JWT_SECRET=your-super-secure-jwt-secret-here-change-this

# Security features
ENABLE_SECURITY_HEADERS=true
ENABLE_RATE_LIMIT=true
ENABLE_AUDIT_LOG=true
ENABLE_ENCRYPTION=true

# =======================
# DATABASE CONFIGURATION
# =======================
# PostgreSQL connection
DATABASE_URL=postgresql://vitaia:your-secure-db-password@postgres:5432/vitaia_db
POSTGRES_USER=vitaia
POSTGRES_PASSWORD=your-secure-db-password
POSTGRES_DB=vitaia_db
POSTGRES_PORT=5432

# =======================
# REDIS CONFIGURATION
# =======================
REDIS_URL=redis://:your-redis-password@redis:6379
REDIS_PASSWORD=your-redis-password
REDIS_PORT=6379

# =======================
# AI PROVIDERS CONFIGURATION
# =======================
# Configure at least one AI provider

# OpenAI/ChatGPT
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.0-flash-exp

# DeepSeek
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# AI Provider Settings
DEFAULT_AI_PROVIDER=gemini
ENABLE_MULTI_PROVIDER=true
AI_TIMEOUT=30000
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.3

# =======================
# MEDICAL AI SETTINGS
# =======================
ENABLE_MEDICAL_VALIDATION=true
ENABLE_CLINICAL_GUIDELINES=true
ENABLE_DRUG_INTERACTION_CHECK=true

# =======================
# LOGGING CONFIGURATION
# =======================
LOG_LEVEL=info
ENABLE_DEBUG_LOGS=false

# =======================
# NGINX CONFIGURATION
# =======================
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
APP_PORT=5000

# =======================
# FRONTEND CONFIGURATION
# =======================
VITE_APP_TITLE=VITAIA Medical AI
VITE_APP_LOGO=https://your-domain.com/logo.svg

# =======================
# MONITORING & ALERTS
# =======================
# Configure monitoring services (optional)
SENTRY_DSN=your-sentry-dsn-here
DATADOG_API_KEY=your-datadog-key-here
SLACK_WEBHOOK_URL=your-slack-webhook-here

# =======================
# BACKUP CONFIGURATION
# =======================
# Database backup settings
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=your-backup-bucket
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# =======================
# SSL/TLS CONFIGURATION
# =======================
# SSL certificate paths (for nginx)
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# =======================
# COMPLIANCE SETTINGS
# =======================
# LGPD/GDPR compliance
ENABLE_DATA_RETENTION_POLICY=true
DATA_RETENTION_MONTHS=36
ENABLE_RIGHT_TO_BE_FORGOTTEN=true
ENABLE_DATA_PORTABILITY=true

# =======================
# PERFORMANCE SETTINGS
# =======================
# Connection pooling
DB_POOL_SIZE=20
DB_POOL_TIMEOUT=30000

# Caching
ENABLE_REDIS_CACHE=true
CACHE_TTL=3600

# =======================
# FEATURE FLAGS
# =======================
ENABLE_RESEARCH_PROTOCOLS=true
ENABLE_EHR_INTEGRATION=true
ENABLE_IMAGE_ANALYSIS=true
ENABLE_VOICE_TRANSCRIPTION=false