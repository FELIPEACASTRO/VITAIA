# VITAIA - Variáveis de Ambiente (Desenvolvimento Local)
# Copie este arquivo para .env e configure os valores

# =======================
# DATABASE (Configurado automaticamente pelo Docker Compose)
# =======================
DATABASE_URL=postgresql://vitaia:vitaia_dev_password@localhost:5432/vitaia_db
PGHOST=localhost
PGPORT=5432
PGUSER=vitaia
PGPASSWORD=vitaia_dev_password
PGDATABASE=vitaia_db

# =======================
# APPLICATION
# =======================
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# =======================
# OBSERVAÇÃO: Autenticação removida
# =======================
# A aplicação agora roda sem sistema de autenticação
# Todos os dados são associados ao usuário padrão (ID 1)

# =======================
# AI/LLM (Opcional)
# =======================
# Configure se for usar recursos de IA
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
OPENAI_API_KEY=

# =======================
# FRONTEND (Vite)
# =======================
VITE_APP_TITLE=VITAIA
VITE_APP_LOGO=https://placehold.co/128x128/10B981/FFFFFF?text=V
