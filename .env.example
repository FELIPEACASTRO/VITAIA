# VITAIA - Variáveis de Ambiente (Desenvolvimento Local)
# Copie este arquivo para .env e configure os valores

# =======================
# DATABASE (Configurado automaticamente pelo Docker Compose)
# =======================
DATABASE_URL=postgresql://vitaia:vitaia_dev_password@localhost:5432/vitaia_db
PGHOST=localhost
PGPORT=5432
PGUSER=vitaia
PGPASSWORD=vitaia_dev_password
PGDATABASE=vitaia_db

# =======================
# APPLICATION
# =======================
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# =======================
# SEGURANÇA - JWT/Cookies
# =======================
# IMPORTANTE: Altere este valor em produção para uma string aleatória segura
JWT_SECRET=vitaia_dev_secret_change_in_production_12345

# =======================
# OAUTH AUTHENTICATION (Opcional)
# =======================
# Configure seu provedor OAuth (Google, GitHub, Auth0, etc.)
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=

# =======================
# AI/LLM (Opcional)
# =======================
# Configure se for usar recursos de IA
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
OPENAI_API_KEY=

# =======================
# FRONTEND (Vite)
# =======================
VITE_APP_TITLE=VITAIA
VITE_APP_LOGO=https://placehold.co/128x128/10B981/FFFFFF?text=V
