# VITAIA - Variáveis de Ambiente (Desenvolvimento Local)
# Copie este arquivo para .env e configure os valores

# =======================
# DATABASE (Configurado automaticamente pelo Docker Compose)
# =======================
DATABASE_URL=postgresql://vitaia:vitaia_dev_password@localhost:5432/vitaia_db
PGHOST=localhost
PGPORT=5432
PGUSER=vitaia
PGPASSWORD=vitaia_dev_password
PGDATABASE=vitaia_db

# =======================
# APPLICATION
# =======================
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# =======================
# OBSERVAÇÃO: Autenticação removida
# =======================
# A aplicação agora roda sem sistema de autenticação
# Todos os dados são associados ao usuário padrão (ID 1)

# =======================
# AI/LLM MULTI-PROVIDER CONFIGURATION
# =======================
# Configure as chaves de API dos provedores de IA que deseja usar

# Legacy support (mantido para compatibilidade)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# OpenAI/ChatGPT Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_URL=https://api.openai.com/v1

# Google Gemini Configuration  
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta

# DeepSeek Configuration
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_URL=https://api.deepseek.com/v1

# AI Provider Settings
# Opções: openai, gemini, deepseek
DEFAULT_AI_PROVIDER=gemini
# Habilita fallback automático entre provedores
ENABLE_MULTI_PROVIDER=true

# =======================
# FRONTEND (Vite)
# =======================
VITE_APP_TITLE=VITAIA
VITE_APP_LOGO=https://placehold.co/128x128/10B981/FFFFFF?text=V
